<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="46">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"Init"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
[ENABLE]
package.loaded.ny_ce_utils = nil
nyce = require('ny_ce_utils')

local function main()
  nyce.addCompactMenu()
  nyce.autoAttach('MagicalPrincess.exe')
end

if syntaxcheck then return end
main()


[DISABLE]



</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>114071</ID>
          <Description>"Status Editor"</Description>
          <Options moHideChildren="1"/>
          <ShowAsHex>1</ShowAsHex>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
nyce = nyce or require('ny_ce_utils')
nyce.ensure_monopipe()

local myDataClass = mono_findClass("", "MyData")
local instanceFieldAddr = nyce.resolveMonoPath(myDataClass, "instance")
if readPointer(instanceFieldAddr) == 0 then
  error("MyData.instance is not initialized yet")
end

nyce.createMonoInstanceRecord({
  fields = {
    {path="status.money", name="Money"},
    {path="status.moneyGetTotal", name="Money Get Total"},
    {path="status.blackCoin", name="Black Coin"},
    {path="status.blackCoinGettedFromDice", name="Black Coin From Dice"},
    {path="status.skillPoint", name="Skill Point"},
    {path="status.activePower", name="Active Power"},
    {path="status.activePowerMax", name="Active Power Max"},
    {path="status.valuePhysical", name="Stat - Physical"},
    {path="status.valueIntelligence", name="Stat - Intelligence"},
    {path="status.valueCharm", name="Stat - Charm"},
    {path="status.valueSense", name="Stat - Sense"},
    {path="status.levelPhysical", name="Level - Physical"},
    {path="status.levelIntelligence", name="Level - Intelligence"},
    {path="status.levelCharm", name="Level - Charm"},
    {path="status.levelSense", name="Level - Sense"},
    {path="status.levelBattle", name="Level - Battle"},
    {path="status.levelArts", name="Level - Arts"},
    {path="status.levelMagic", name="Level - Magic"},
    {path="status.btlExp", name="Battle Exp"},
    {path="status.phyKinryoku", name="Physical - Kinryoku"},
    {path="status.phySeimei", name="Physical - Seimei"},
    {path="status.phyKonjyo", name="Physical - Konjyo"},
    {path="status.phyBinsho", name="Physical - Binsho"},
    {path="status.intBungaku", name="Intelligence - Bungaku"},
    {path="status.intSanjyutsu", name="Intelligence - Sanjyutsu"},
    {path="status.intMajyutsu", name="Intelligence - Majyutsu"},
    {path="status.intShinkou", name="Intelligence - Shinkou"},
    {path="status.chaBibou", name="Charm - Bibou"},
    {path="status.chaShakou", name="Charm - Shakou"},
    {path="status.chaReigi", name="Charm - Reigi"},
    {path="status.chaDoutoku", name="Charm - Doutoku"},
    {path="status.senSouzou", name="Sense - Souzou"},
    {path="status.senSousaku", name="Sense - Sousaku"},
    {path="status.senOnkan", name="Sense - Onkan"},
    {path="status.senBikan", name="Sense - Bikan"},
    {path="status.salaryRate", name="Rate - Salary"},
    {path="status.buyPriceRate", name="Rate - Buy Price"},
    {path="status.salePriceRate", name="Rate - Sale Price"},
    {path="status.phyRate", name="Rate - Physical Gain"},
    {path="status.intRate", name="Rate - Intelligence Gain"},
    {path="status.chaRate", name="Rate - Charm Gain"},
    {path="status.senRate", name="Rate - Sense Gain"},
    {path="status.actStatusRate", name="Rate - Activity Status"},
    {path="status.battleMoneyRate", name="Rate - Battle Money"},
    {path="status.sfBlackCoinRate", name="Rate - Black Coin"},
  },
  parent = memrec,
  class = myDataClass,
})

memrec.ShowAsHex = true
memrec.Address = ("%x"):format(instanceFieldAddr)
memrec.OffsetCount = 1
memrec.Offset[0] = 0
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
while memrec.Count &gt; 0 do
  memrec.Child[0].destroy()
end
{$asm}

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>114072</ID>
          <Description>"Reward Multipliers"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
nyce = nyce or require('ny_ce_utils')

RewardMultipliers_hookInfo = nyce.createSimpleHook({
  method = nyce.findMonoFunction("", "MyData", "AddParams", "string,CharaType,LocationType,ActivityType,SituationType,string,single,single,bool"),
  code = [[
movss xmm0, [${_Var_}]
mulss xmm0, [rsp+40]
movss [rsp+40], xmm0
movss xmm0, [${_Var_}+4]
mulss xmm0, [rsp+48]
movss [rsp+48], xmm0
]],
  vars = "RewardMultipliers"
})
writeFloat("RewardMultipliers", 1)
writeFloat("RewardMultipliers+4", 1)
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
nyce.removeSimpleHook(RewardMultipliers_hookInfo)
RewardMultipliers_hookInfo = nil
{$asm}

</AssemblerScript>
          <CheatEntries>
            <CheatEntry>
              <ID>114073</ID>
              <Description>"Money Reward Multiplier"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Float</VariableType>
              <Address>RewardMultipliers</Address>
            </CheatEntry>
            <CheatEntry>
              <ID>114074</ID>
              <Description>"Activity/Skill Reward Multiplier"</Description>
              <ShowAsSigned>0</ShowAsSigned>
              <VariableType>Float</VariableType>
              <Address>RewardMultipliers+4</Address>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
        <CheatEntry>
          <ID>114075</ID>
          <Description>"No Skill Point Cost"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
nyce = nyce or require('ny_ce_utils')

local method = nyce.findMonoFunction("", "MyData", "LearnSkillFromSkillId", "int")
local patchAt = method + 0x32
local b1, b2 = readBytes(patchAt, 2)
if b1 ~= 0xFF or b2 ~= 0xC9 then
  error(("Unexpected LearnSkillFromSkillId bytes at %X: %02X %02X"):format(patchAt, b1 or 0, b2 or 0))
end
NoSkillPointCost_patchInfo = nyce.createBytesPatch(patchAt, "90 90")
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
nyce.restoreBytesPatch(NoSkillPointCost_patchInfo)
NoSkillPointCost_patchInfo = nil
{$asm}

</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
  <LuaScript>
</LuaScript>
</CheatTable>